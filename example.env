APP_ENV=production
DATABASE_URL=
HEALTH_CHECK_URL=
FACTORY_CONTRACT_ID=
REWARDS_CONTRACT_ID=
FIAT_SAFE_ADDRESS=
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Below-retention replay. Hubble (SDF's public BigQuery dataset) keeps every
# ledger from genesis and is preferred; it needs a billing-enabled GCP project
# and Application Default Credentials (GOOGLE_APPLICATION_CREDENTIALS locally,
# the attached identity on GCP). The reader pays for scanned bytes, not SDF.
# PUBNET ONLY — SDF publishes no testnet dataset. On testnet leave this unset;
# the worker verifies the dataset's tip against the RPC's and refuses a
# mismatch, falling back to the RPC replay below.
HUBBLE_BILLING_PROJECT=
HUBBLE_DATASET=crypto-stellar.crypto_stellar
HUBBLE_MAX_SPAN=120000
# Fallback used when Hubble is unconfigured or its credentials fail. Bounded by
# this endpoint's own retention, so it cannot reach a gap older than that; MAY
# be the same URL as SOROBAN_RPC_URL. Unset leaves no replay at all and gaps
# below live retention are skipped.
BACKFILL_SOURCE_URL=https://soroban-rpc.testnet.stellar.gateway.fm
BACKFILL_MAX_SPAN=120000
START_LEDGER=0
POLL_INTERVAL_MS=5000
